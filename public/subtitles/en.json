    "t": "ask an Algerian for his papers?"
  },
  {
    "s": 3512.2,
    "e": 3513.2,
    "t": "No one!"
  },
  {
    "s": 3514.9,
    "e": 3516.8,
    "t": "This is what the Party gives the nation."
  },
  {
    "s": 3517.8,
    "e": 3520.9,
    "t": "This is what it lays\nat the feet of its children."
  },
  {
    "s": 3521.4,
    "e": 3524.2,
    "t": "May no one ever impose on them"
  },
  {
    "s": 3524.3,
    "e": 3526.9,
    "t": "their laws or their truth."
  },
  {
    "s": 3531.2,
    "e": 3533.1,
    "t": "The world is watching us!"
  },
  {
    "s": 3534.2,
    "e": 3536.0,
    "t": "Yes, the world is watching us!"
  },
  {
    "s": 3536.1,
    "e": 3537.8,
    "t": "Let us be worthy of our victory!"
  },
  {
    "s": 3562.4,
