    "t": "That son of a bitch has decided..."
  },
  {
    "s": 4100.0,
    "e": 4101.6,
    "t": "But we're watching him."
  },
  {
    "s": 4102.5,
    "e": 4104.4,
    "t": "He's digging into your affairs."
  },
  {
    "s": 4104.6,
