  },
  {
    "s": 4765.4,
    "e": 4768.9,
    "t": "It's simple. If we can't understand\neach other on the production line,"
  },
  {
    "s": 4769.5,
    "e": 4772.0,
    "t": "we put the men at risk."
  },
  {
    "s": 4772.1,
    "e": 4780.5,
    "t": "Me refuse to speak\nin colonizer's language."
  },
  {
    "s": 4780.6,
    "e": 4782.0,
    "t": "I'm begging you."
  },
  {
    "s": 4786.0,
    "e": 4787.0,
    "t": "One minute."
  },
  {
    "s": 4788.7,
    "e": 4790.8,
    "t": "You could have warned me."
  },
  {
    "s": 4791.0,
    "e": 4792.4,
