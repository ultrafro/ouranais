  {
    "s": 3637.2,
    "e": 3638.6,
    "t": "Shut up! Stop it!"
  },
  {
    "s": 3644.1,
    "e": 3645.2,
    "t": "It's nothing."
  },
  {
    "s": 3711.2,
    "e": 3712.7,
    "t": "He's a son of a bitch!"
  },
  {
    "s": 3967.0,
    "e": 3968.6,
    "t": "That's a good investment."
  },
  {
