  },
  {
    "s": 4058.0,
    "e": 4059.8,
    "t": "Don't even mention oil."
  },
  {
    "s": 4063.7,
    "e": 4066.3,
    "t": "When I get home\nempty-handed,"
  },
  {
    "s": 4066.6,
