    "t": "Did you enjoy your meal?"
  },
  {
    "s": 3565.0,
    "e": 3566.1,
    "t": "Thank you very much!"
  },
  {
    "s": 3577.0,
    "e": 3578.6,
    "t": "A proper little colonel."
  },
  {
    "s": 3605.8,
