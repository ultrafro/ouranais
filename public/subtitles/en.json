  },
  {
    "s": 1301.4,
    "e": 1302.8,
    "t": "She waited."
  },
  {
    "s": 1304.1,
    "e": 1307.5,
    "t": "She hoped for word from you,\nbut it never came."
  },
  {
    "s": 1312.7,
    "e": 1315.6,
    "t": "She stopped eating. She grew thin."
  },
  {
    "s": 1317.6,
