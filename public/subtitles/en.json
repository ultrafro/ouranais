  },
  {
    "s": 4794.0,
    "e": 4796.6,
    "t": "Exactly... I..."
  },
  {
    "s": 4796.7,
    "e": 4802.0,
    "t": "Wait! Speak normally."
  },
  {
    "s": 4803.2,
    "e": 4805.3,
    "t": "It's the law, Your Excellency."
  },
  {
    "s": 4806.0,
    "e": 4807.6,
    "t": "It's the law!"
  },
  {
    "s": 4808.2,
    "e": 4809.4,
    "t": "Mr. Djaffar,"
  },
  {
    "s": 4809.8,
    "e": 4812.0,
    "t": "I've always worked in this factory."
  },
  {
    "s": 4812.8,
    "e": 4815.3,
    "t": "And I learned the trade in French."
  },
  {
    "s": 4816.0,
