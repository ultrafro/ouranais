    "t": "Your Excellency,"
  },
  {
    "s": 4123.3,
    "e": 4125.3,
    "t": "you're a veteran."
  },
  {
    "s": 4125.7,
    "e": 4128.8,
    "t": "Why are you protecting the Commander?"
  },
  {
    "s": 4129.5,
    "e": 4130.8,
    "t": "What's it to you?"
  },
  {
    "s": 4132.7,
    "e": 4134.2,
    "t": "Let me know when he gets back."
  },
  {
    "s": 4134.8,
    "e": 4136.8,
    "t": "I'll pick him up at the airport."
  },
  {
    "s": 4150.8,
    "e": 4153.4,
    "t": "Anyone who doesn't get rich\nunder this president"
  },
  {
    "s": 4153.5,
    "e": 4155.0,
    "t": "never will."
  },
  {
    "s": 4295.4,
    "e": 4296.5,
    "t": "Bring the dish."
  },
  {
    "s": 4296.7,
    "e": 4298.2,
    "t": "And have something to eat yourself."
  },
  {
    "s": 4402.7,
    "e": 4405.6,
    "t": "And you bore us to death\nwith your damn politics!"
  },
  {
    "s": 4476.4,
    "e": 4477.8,
    "t": "I don't even know her!"
  },
  {
    "s": 4750.3,
    "e": 4751.5,
    "t": "You know that, don't you?"
  },
  {
    "s": 4760.1,
    "e": 4762.9,
