  },
  {
    "s": 2265.2,
    "e": 2267.5,
    "t": "I want Canadian customers!"
  },
  {
    "s": 2277.8,
    "e": 2279.7,
    "t": "I swear!\nCalm down, Djaffar."
  },
  {
    "s": 2297.7,
    "e": 2300.0,
    "t": "It goes around and ends up getting lost."
  },
  {
    "s": 2303.6,
    "e": 2305.3,
    "t": "Idiots. Sons of bitches."
  },
  {
    "s": 2636.4,
    "e": 2638.9,
    "t": "Fourteen stamps for one letter!"
  },
  {
    "s": 2642.8,
    "e": 2644.2,
    "t": "How are you?"
  },
  {
    "s": 2645.8,
    "e": 2647.4,
    "t": "Fine, thank you."
  },
  {
    "s": 2653.5,
    "e": 2655.1,
    "t": "And how are you?"
  },
  {
    "s": 2655.6,
    "e": 2656.7,
    "t": "Thanks be to God."
  },
  {
    "s": 2664.5,
    "e": 2667.0,
