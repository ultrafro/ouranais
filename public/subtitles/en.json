  },
  {
    "s": 1322.0,
    "e": 1325.1,
    "t": "She wanted to kill the baby,\nbut he held on."
  },
  {
    "s": 1327.6,
    "e": 1329.8,
    "t": "God wanted him to live."
  },
  {
    "s": 1332.1,
    "e": 1334.3,
    "t": "I was there when she gave birth."
  },
  {
    "s": 1337.4,
    "e": 1339.6,
    "t": "I saw death in her eyes."
  },
  {
    "s": 1341.0,
