    "t": "What's that?"
  },
  {
    "s": 1952.3,
    "e": 1957.0,
    "t": "An older boy\npushed me over."
  },
  {
    "s": 2156.2,
    "e": 2157.6,
    "t": "Yes, Farouk, I'm listening."
  },
  {
    "s": 2159.8,
    "e": 2161.5,
    "t": "Who worked on it before?"
  },
  {
