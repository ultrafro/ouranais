  },
  {
    "s": 2174.3,
    "e": 2176.2,
    "t": "You should have told me right away."
  },
  {
    "s": 2176.7,
    "e": 2181.0,
    "t": "With the ministry people and television,\nI didn't dare."
  },
  {
    "s": 2223.2,
    "e": 2225.4,
    "t": "Bachir, come and eat."
  },
  {
    "s": 2243.9,
    "e": 2245.6,
    "t": "Look at that workmanship!"
  },
  {
    "s": 2245.7,
    "e": 2248.0,
    "t": "That's why the French\ndidn't want to explain anything."
  },
  {
    "s": 2248.1,
    "e": 2251.7,
    "t": "We'll get production back up\nwith the same quality."
  },
  {
    "s": 2251.8,
