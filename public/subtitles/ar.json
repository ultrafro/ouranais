    "t": "إنه استثمار جيد."
  },
  {
    "s": 3971.0,
    "e": 3973.0,
    "t": "خمسة وعشرون عاما من الاستقلال."
  },
  {
    "s": 3985.4,
    "e": 3986.9,
    "t": "أحسن صنعا حين استثمر."
  },
  {
    "s": 3989.5,
    "e": 3990.8,
    "t": "عم تتحدث؟"
  },
  {
    "s": 3993.3,
    "e": 3995.1,
    "t": "مع احترامي الكامل،"
  },
  {
    "s": 3995.6,
    "e": 3998.0,
    "t": "أتظن أن شيئا\nيفوتنا؟"
  },
  {
    "s": 4000.0,
    "e": 4003.0,
    "t": "أعرف أنك مجرد المدير."
  },
  {
    "s": 4005.2,
    "e": 4007.4,
    "t": "والمطعم ملك"
  },
  {
    "s": 4007.9,
    "e": 4009.0,
    "t": "للقائد."
  },
  {
    "s": 4013.4,
    "e": 4014.7,
    "t": "ماذا تريد؟"
  },
  {
    "s": 4016.8,
    "e": 4018.8,
    "t": "لا، لست كذلك!"
  },
  {
    "s": 4018.9,
    "e": 4022.1,
    "t": "لا أريد أن أسبب متاعب\nللقائد."
  },
  {
    "s": 4024.6,
    "e": 4025.7,
    "t": "ماذا تشرب؟"
  },
  {
    "s": 4026.5,
    "e": 4029.3,
    "t": "جعة، مع كامل احترامي."
  },
  {
    "s": 4041.9,
    "e": 4045.6,
    "t": "حين يرى المرء مكانا كهذا،"
  },
  {
    "s": 4045.9,
    "e": 4049.5,
    "t": "يظن أنكم\nتتلقون الإمدادات بانتظام."
  },
  {
    "s": 4051.0,
    "e": 4053.0,
    "t": "هذا ترف هذه الأيام."
  },
  {
    "s": 4053.8,
    "e": 4056.9,
    "t": "صحيح.\nلا نجد الزبدة ولا البيض."
  },
  {
    "s": 4058.0,
    "e": 4059.8,
    "t": "أما الزيت، فحدث ولا حرج."
  },
  {
    "s": 4063.7,
    "e": 4066.3,
    "t": "حين أعود إلى البيت\nخالي اليدين،"
  },
  {
    "s": 4066.6,
    "e": 4068.5,
    "t": "تشن زوجتي الحرب علي."
  },
  {
    "s": 4072.6,
    "e": 4076.6,
    "t": "مر بالمطبخ عند خروجك،\nوستنعم بالسلام."
  },
  {
    "s": 4081.5,
    "e": 4082.7,
    "t": "أنا أسمعك."
  },
  {
    "s": 4090.4,
    "e": 4091.7,
    "t": "Mehdi Laloui."
  },
  {
    "s": 4092.0,
    "e": 4094.0,
    "t": "صحفي ثقافي."
  },
  {
    "s": 4095.2,
    "e": 4097.6,
    "t": "قرر ابن العاهرة هذا"
  },
  {
    "s": 4097.9,
    "e": 4099.6,
    "t": "أن يدخل السياسة."
  },
  {
    "s": 4100.0,
    "e": 4101.6,
    "t": "لكننا نراقبه."
  },
  {
    "s": 4102.5,
    "e": 4104.4,
    "t": "إنه ينبش في شؤونكم."
  },
  {
    "s": 4104.6,
    "e": 4106.5,
    "t": "لكنني لا أعرف ما الذي يبحث عنه."
  },
  {
    "s": 4108.7,
    "e": 4109.8,
    "t": "أين أجده؟"
  },
  {
    "s": 4120.9,
    "e": 4122.0,
    "t": "يا صاحب السعادة،"
  },
  {
    "s": 4123.3,
    "e": 4125.3,
    "t": "أنت من المحاربين القدامى."
  },
  {
    "s": 4125.7,
    "e": 4128.8,
    "t": "لماذا تحمي القائد؟"
  },
  {
    "s": 4129.5,
    "e": 4130.8,
    "t": "ما شأنك؟"
  },
  {
    "s": 4132.7,
    "e": 4134.2,
    "t": "أخبرني حين يعود."
  },
  {
    "s": 4134.8,
    "e": 4136.8,
    "t": "سأقبض عليه في المطار."
  },
  {
    "s": 4150.8,
    "e": 4153.4,
    "t": "من لا يغتني\nفي عهد هذا الرئيس"
  },
  {
    "s": 4153.5,
    "e": 4155.0,
    "t": "فلن يغتني أبدا."
  },
  {
    "s": 4295.4,
    "e": 4296.5,
    "t": "أحضر الطبق."
  },
  {
    "s": 4296.7,
    "e": 4298.2,
    "t": "وكل أنت أيضا."
  },
  {
    "s": 4402.7,
    "e": 4405.6,
    "t": "لقد سئمنا\nمن سياستكم اللعينة!"
  },
  {
    "s": 4476.4,
    "e": 4477.8,
    "t": "أنا لا أعرفها حتى!"
  },
  {
    "s": 4750.3,
    "e": 4751.5,
    "t": "أنت تعرف ذلك، أليس كذلك؟"
  },
  {
    "s": 4760.1,
    "e": 4762.9,
    "t": "قرر Azzedine\nأن علينا في وحدة الإنتاج"
  },
  {
    "s": 4763.0,
    "e": 4765.3,
    "t": "أن نتحدث\nبالعربية الفصحى."
  },
  {
    "s": 4765.4,
    "e": 4768.9,
    "t": "الأمر بسيط. إن لم نفهم بعضنا\nعلى خط الإنتاج،"
  },
  {
    "s": 4769.5,
    "e": 4772.0,
    "t": "فإننا نعرض العمال للخطر."
  },
  {
    "s": 4772.1,
    "e": 4773.3,
    "t": "بالعربية الفصحى؟"
  },
  {
    "s": 4773.6,
    "e": 4776.6,
    "t": "أنا أرفض بلغة المستعمر\nأن أعبر."
  },
  {
    "s": 4776.9,
    "e": 4780.2,
    "t": "أيها القائد المحارب القديم،\nالقدوة أن تعطي يجب عليك."
  },
  {
    "s": 4780.6,
    "e": 4782.0,
    "t": "أتوسل إليك."
  },
  {
    "s": 4786.0,
    "e": 4787.0,
    "t": "لحظة واحدة."
  },
  {
    "s": 4788.7,
    "e": 4790.8,
    "t": "كان بإمكانك إخباري."
  },
  {
    "s": 4791.0,
    "e": 4792.4,
    "t": "أن تناقشني في الأمر أولا."
  },
  {
    "s": 4794.0,
    "e": 4796.6,
    "t": "بالضبط... أنا..."
  },
  {
    "s": 4796.7,
    "e": 4798.8,
    "t": "واضحا بدا أنه كان."
  },
  {
    "s": 4799.7,
    "e": 4802.0,
    "t": "انتظر! تكلم بشكل طبيعي."
  },
  {
    "s": 4803.2,
    "e": 4805.3,
    "t": "إنه القانون يا صاحب السعادة."
  },
  {
    "s": 4806.0,
    "e": 4807.6,
    "t": "إنه القانون!"
  },
  {
    "s": 4808.2,
    "e": 4809.4,
    "t": "سيد Djaffar،"
  },
  {
    "s": 4809.8,
    "e": 4812.0,
    "t": "عملت دائما في هذا المصنع."
  },
  {
    "s": 4812.8,
    "e": 4815.3,
    "t": "وتعلمت المهنة بالفرنسية."
  },
  {
    "s": 4816.0,
    "e": 4817.3,
    "t": "هل هذا ذنبي؟"
  },
  {
    "s": 4817.4,
    "e": 4818.2,
    "t": "لا."
  },
  {
    "s": 4820.5,
    "e": 4822.2,
    "t": "لا أعرف حتى كيف أقول"
  },
  {
    "s": 4822.4,
    "e": 4825.2,
    "t": "«منشار معدني» بالفصحى!"
  },
  {
    "s": 4825.4,
    "e": 4827.4,
    "t": "«منشار معدني». حسنا، ربما..."
  },
  {
    "s": 4828.0,
    "e": 4832.3,
    "t": "ربما يعرف Azzedine كيف يقول\n«منشار معدني» بالفصحى."
  },
  {
    "s": 4834.4,
    "e": 4835.3,
    "t": "Azzedine؟"
  },
  {
    "s": 4836.4,
    "e": 4839.6,
    "t": "«منشار معدني» بالفصحى؟"
  },
  {
    "s": 4861.6,
    "e": 4862.6,
    "t": "الأمر بسيط."
  },
  {
    "s": 4863.8,
    "e": 4865.9,
    "t": "سيستخدم Farouk «المنشار المعدني»،"
  },
  {
    "s": 4866.2,
