  {
    "s": 4920.5,
    "e": 4921.5,
    "t": "أعرف!"
  },
  {
    "s": 4921.7,
    "e": 4924.7,
    "t": "أهذا كل شيء؟ هل ولدت\nوماتت في اليوم نفسه؟"
  },
  {
    "s": 4926.3,
    "e": 4928.2,
    "t": "أنت تتحدث عن أمك يا Bachir."
  },
  {
    "s": 4930.4,
    "e": 4933.0,
    "t": "ماذا كانت تحب؟"
  },
  {
    "s": 4933.2,
    "e": 4935.2,
    "t": "ماذا كانت تفعل\nحين كانت في سني؟"
  },
  {
    "s": 4935.4,
    "e": 4937.8,
    "t": "كأنها لم تكن في سني قط."
  },
  {
    "s": 4942.4,
    "e": 4944.2,
    "t": "اقرأ ما كتب هناك."
  },
  {
    "s": 4944.3,
    "e": 4947.1,
    "t": "لم يقتلها الجنود!\nأنا أعرف!"
  },
  {
    "s": 4957.0,
    "e": 4958.1,
    "t": "لقد كذبت علي."
  },
  {
    "s": 4962.5,
    "e": 4964.3,
    "t": "أنت تخفي أشياء عني!"
  },
  {
    "s": 4983.3,
    "e": 4985.3,
    "t": "طلبية للكنديين!"
  },
  {
    "s": 4988.7,
    "e": 4991.1,
    "t": "تهانينا أيها القائد Djaffar!"
  },
  {
    "s": 4991.4,
    "e": 4994.3,
    "t": "نجحنا! حققنا هدفنا!"
  },
  {
    "s": 4994.4,
    "e": 4996.2,
    "t": "طلبية كندية!"
  },
  {
    "s": 4999.2,
    "e": 5000.2,
    "t": "Farouk،"
  },
  {
    "s": 5001.1,
    "e": 5002.4,
    "t": "أرسل لي"
  },
  {
    "s": 5003.5,
    "e": 5005.9,
    "t": "أمر الشراء. سأتولى الأمر."
  },
  {
    "s": 5006.7,
    "e": 5008.2,
    "t": "سأتكفل بالأمر."
  },
  {
    "s": 5222.1,
    "e": 5224.2,
    "t": "بيع شركة"
  },
  {
    "s": 5225.5,
    "e": 5226.6,
    "t": "El Armador."
  },
  {
    "s": 5375.6,
    "e": 5376.7,
    "t": "اختفى!"
  },
  {
    "s": 5380.6,
    "e": 5382.5,
    "t": "إن كانت الاستخبارات،"
  },
  {
    "s": 5383.1,
    "e": 5385.4,
    "t": "فلا بد أنهم استشاروا Hamid أولا."
  },
  {
    "s": 5411.0,
    "e": 5412.6,
    "t": "أنا في مكتبك."
  },
  {
    "s": 5422.8,
    "e": 5424.0,
    "t": "ابق هناك."
  },
  {
    "s": 5504.8,
    "e": 5506.0,
    "t": "اتركني!"
  },
  {
    "s": 5634.8,
    "e": 5636.0,
    "t": "ابقي جالسة."
  },
  {
    "s": 5774.7,
    "e": 5777.0,
    "t": "قال خمس مرات في اليوم، لا خمس عشرة."
  },
  {
    "s": 5779.4,
    "e": 5781.6,
    "t": "لم يعد هذا إيمانا، بل غضبا."
  },
  {
    "s": 5801.4,
    "e": 5811.7,
    "t": "حسنا..."
  },
  {
    "s": 5848.1,
    "e": 5850.0,
    "t": "كان الصحفي مسجلا على هذه الرحلة."
  },
  {
    "s": 5850.1,
    "e": 5853.0,
    "t": "[حوار غير واضح]"
  },
  {
    "s": 5853.3,
    "e": 5855.0,
    "t": "هل حذروه؟\nما رأيك؟"
  },
  {
    "s": 5855.1,
    "e": 5858.4,
    "t": "لا بد أنهم أخبروه أن أحمق\nمن الاستخبارات ينتظره."
  },
  {
    "s": 5861.5,
    "e": 5863.6,
    "t": "لا يهم، سأمسك به في بيته."
  },
  {
    "s": 5864.7,
    "e": 5867.1,
    "t": "أتظنه غبيا بما يكفي\nليعود إلى بيته"
  },
  {
    "s": 5867.2,
    "e": 5868.9,
    "t": "ونحن نبحث عنه؟"
  },
  {
    "s": 5870.9,
    "e": 5872.7,
    "t": "أعرف من سيذهب لرؤيته."
  },
  {
    "s": 5897.7,
    "e": 5899.5,
    "t": "Bachir، الماء ليس عميقا بما يكفي!"
  },
  {
    "s": 5899.8,
    "e": 5901.6,
    "t": "Bachir، اقفز إن كنت رجلا!"
  },
  {
    "s": 6011.3,
    "e": 6012.2,
    "t": "Nadir."
  },
  {
    "s": 6013.7,
    "e": 6015.0,
    "t": "سأنكحها."
  },
  {
    "s": 6035.3,
    "e": 6036.7,
    "t": "أتريد واحدة أخرى؟"
  },
  {
    "s": 6084.7,
    "e": 6086.2,
    "t": "أتريد أن تتبعه؟\nلا."
  },
  {
    "s": 6086.4,
    "e": 6087.3,
    "t": "سنبقى جالسين."
  },
  {
    "s": 6088.3,
    "e": 6090.5,
    "t": "لا تفزعوا يا أولاد العاهرة.\nأنا هنا."
  },
  {
    "s": 6090.9,
    "e": 6093.5,
    "t": "ألم تبدل نوبته؟\nلا، إنه دورك."
  },
  {
    "s": 6095.9,
    "e": 6097.6,
    "t": "الشراب على حسابي. اذهب وبدل نوبته."
  },
  {
    "s": 6098.0,
    "e": 6099.7,
    "t": "هيا، انهض!"
  },
  {
    "s": 6099.9,
    "e": 6100.7,
    "t": "تحرك!"
  },
  {
    "s": 6105.6,
    "e": 6106.8,
    "t": "من هذا الرجل؟"
  },
  {
    "s": 6107.2,
    "e": 6108.6,
    "t": "نباش فضائح."
  },
  {
    "s": 6126.8,
    "e": 6131.0,
    "t": "نقل إلى المستشفى العسكري،\nحيث تلقى العلاج."
  },
  {
    "s": 6131.3,
    "e": 6132.4,
    "t": "رئيس الجمهورية."
  },
  {
    "s": 6156.7,
    "e": 6160.3,
    "t": "لماذا تتطفل\nعلى شؤون الآخرين؟"
  },
  {
    "s": 6161.2,
    "e": 6162.8,
    "t": "عما تبحث؟"
  },
  {
    "s": 6171.2,
    "e": 6172.8,
    "t": "قل لي عما تبحث."
  },
  {
    "s": 6172.9,
    "e": 6174.9,
    "t": "ماذا تريد من ابن الرئيس؟"
  },
  {
    "s": 6175.2,
    "e": 6177.2,
    "t": "تبكي مثل فتاة."
  },
  {
    "s": 6183.9,
    "e": 6185.3,
    "t": "أتستهزئ بي؟"
  },
  {
    "s": 6196.1,
    "e": 6197.3,
    "t": "انتظر!"
  },
  {
    "s": 6198.3,
    "e": 6199.7,
    "t": "إنه يخدعنا."
  },
  {
    "s": 6199.9,
    "e": 6201.7,
    "t": "اتركنا. سأتولى أمره."
  },
  {
    "s": 6211.7,
    "e": 6213.3,
    "t": "يا حقير!"
  },
  {
    "s": 6245.9,
    "e": 6247.5,
    "t": "كيف تعرف ذلك؟"
  },
  {
    "s": 6249.5,
    "e": 6251.4,
    "t": "لم يكن هناك أحد آخر تلك..."
  },
  {
    "s": 6296.0,
    "e": 6297.0,
    "t": "ماذا؟"
  },
  {
    "s": 6297.4,
    "e": 6298.9,
    "t": "ما الأمر؟"
  },
  {
    "s": 6299.4,
    "e": 6301.2,
    "t": "رآكم ابن Kotias."
  },
  {
    "s": 6301.3,
    "e": 6303.3,
    "t": "اعتدى الجنود على Yasmine."
  },
  {
    "s": 6304.6,
    "e": 6306.4,
    "t": "ماذا فعل أولئك الكلاب؟"
  },
  {
    "s": 6307.7,
    "e": 6308.8,
    "t": "هل قتلوها؟"
  },
  {
