    "t": "وسيعمل Azzedine بـ"
  },
  {
    "s": 4868.1,
    "e": 4869.4,
    "t": "«سيو»"
  },
  {
    "s": 4869.9,
    "e": 4871.3,
    "t": "«الميتاليكو»."
  },
  {
    "s": 4872.5,
    "e": 4873.6,
    "t": "بالتوفيق."
  },
  {
    "s": 4875.5,
    "e": 4876.5,
    "t": "اغرب عن وجهي."
  },
  {
    "s": 4885.3,
    "e": 4887.2,
    "t": "لماذا لا نحتفل أبدا بعيد ميلادي؟"
  },
  {
    "s": 4894.2,
    "e": 4896.8,
    "t": "سنحتفل بالقادم، لم لا؟"
  },
  {
    "s": 4907.0,
    "e": 4909.2,
    "t": "كيف كانت أمي؟"
  },
  {
    "s": 4912.3,
    "e": 4914.8,
    "t": "كانت امرأة شجاعة جدا."
  },
  {
    "s": 4915.2,
    "e": 4918.4,
    "t": "قاتلت الجنود"
  },
  {
    "s": 4918.6,
    "e": 4920.4,
    "t": "لتحميني، فقتلوها."
